using System;

// Define an interface called IQuittable
// Interfaces specify what methods a class must implement
public interface IQuittable
{
    // This method has no body because interfaces only define *what* must be done, not *how*
    void Quit();
}

// Define an Employee class
// It inherits the IQuittable interface, meaning it must implement the Quit() method
public class Employee : IQuittable
{
    // Simple property to hold employee name
    public string Name { get; set; }

    // Constructor to set employee name when an object is created
    public Employee(string name)
    {
        Name = name;
    }

    // Implementing the Quit() method defined in the IQuittable interface
    // This describes *how* an Employee quits
    public void Quit()
    {
        Console.WriteLine($"{Name} has quit the company. Goodbye!");
    }
}

// The main Program class that runs the console application
class Program
{
    // Main method: entry point of the application
    static void Main(string[] args)
    {
        // Create an Employee object
        Employee emp = new Employee("John Doe");

        // Use polymorphism: an object can be of an interface type
        // Here, we assign the Employee object to an IQuittable variable
        IQuittable quittableEmployee = emp;

        // Call the Quit() method using the interface reference
        // This demonstrates polymorphism in action
        quittableEmployee.Quit();

        // Wait for user input before closing the console
        Console.ReadLine();
    }
}
